from app.capabilities.appointment_booking import create_appointment_capability
from datetime import datetime

from app.capabilities.availability_search import check_availability
from fastapi import APIRouter, Depends
from sqlmodel import Session, select
from app.database.database import get_session
from app.capabilities.doctor_search import search_doctors


router = APIRouter(
    prefix="/capabilities",
    tags=["AI Capabilities"]
)


@router.get("/search-doctors")
def capability_search_doctors(
    specialty: str | None = None,
    hospital_id: int | None = None,
    session: Session = Depends(get_session)
):
    doctors = search_doctors(
        session=session,
        specialty=specialty,
        hospital_id=hospital_id
    )

    return {
        "capability": "search_doctors",
        "count": len(doctors),
        "doctors": doctors
    }
@router.get("/check-availability")
def capability_check_availability(
    doctor_id: int,
    start_time: datetime | None = None,
    end_time: datetime | None = None,
    session: Session = Depends(get_session)
):
    slots = check_availability(
        session=session,
        doctor_id=doctor_id,
        start_time=start_time,
        end_time=end_time
    )

    return {
        "capability": "check_availability",
        "doctor_id": doctor_id,
        "count": len(slots),
        "slots": slots
    }
@router.post("/create-appointment")
def capability_create_appointment(
    hospital_id: int,
    doctor_id: int,
    patient_id: int,
    start_time: datetime,
    end_time: datetime,
    appointment_type: str = "IN_PERSON",
    idempotency_key: str | None = None,
    session: Session = Depends(get_session)
):
    return create_appointment_capability(
        session=session,
        hospital_id=hospital_id,
        doctor_id=doctor_id,
        patient_id=patient_id,
        start_time=start_time,
        end_time=end_time,
        appointment_type=appointment_type,
        idempotency_key=idempotency_key,
    )
@router.post("/test-unknown-outcome")
def test_unknown_outcome(
    session: Session = Depends(get_session),
):
    from datetime import timedelta

    # Find an available slot for doctor 1
    doctor_id = 1
    hospital_id = 1
    patient_id = 3

    availability_statement = select(Availability).where(
        Availability.doctor_id == doctor_id,
        Availability.is_available == True,
    )

    availability = session.exec(
        availability_statement
    ).first()

    if not availability:
        return {
            "success": False,
            "message": "No availability found for doctor 1.",
        }

    start_time = availability.start_time
    end_time = start_time + timedelta(minutes=30)

    # Run the failure-recovery scenario
    result = create_appointment_capability(
        session=session,
        hospital_id=hospital_id,
        doctor_id=doctor_id,
        patient_id=patient_id,
        start_time=start_time,
        end_time=end_time,
        appointment_type="IN_PERSON",
        idempotency_key=(
            f"unknown-outcome-test-{patient_id}-"
            f"{doctor_id}-{start_time.isoformat()}"
        ),
        simulate_unknown_outcome=True,
    )

    return {
        "test": "UNKNOWN_OUTCOME_RECOVERY",
        "start_time": start_time,
        "end_time": end_time,
        "result": result,
    }
