from app.models.availability import Availability
from app.capabilities.appointment_booking import create_appointment_capability
from datetime import datetime
from app.models.appointment import Appointment
from app.capabilities.availability_search import check_availability
from fastapi import APIRouter, Depends
from sqlmodel import Session, select
from app.database.database import get_session
from app.capabilities.doctor_search import search_doctors


router = APIRouter(
    prefix="/capabilities",
    tags=["AI Capabilities"]
)


@router.get("/search-doctors")
def capability_search_doctors(
    specialty: str | None = None,
    hospital_id: int | None = None,
    session: Session = Depends(get_session)
):
    doctors = search_doctors(
        session=session,
        specialty=specialty,
        hospital_id=hospital_id
    )

    return {
        "capability": "search_doctors",
        "count": len(doctors),
        "doctors": doctors
    }
@router.get("/check-availability")
def capability_check_availability(
    doctor_id: int,
    start_time: datetime | None = None,
    end_time: datetime | None = None,
    session: Session = Depends(get_session)
):
    slots = check_availability(
        session=session,
        doctor_id=doctor_id,
        start_time=start_time,
        end_time=end_time
    )

    return {
        "capability": "check_availability",
        "doctor_id": doctor_id,
        "count": len(slots),
        "slots": slots
    }
@router.post("/create-appointment")
def capability_create_appointment(
    hospital_id: int,
    doctor_id: int,
    patient_id: int,
    start_time: datetime,
    end_time: datetime,
    appointment_type: str = "IN_PERSON",
    idempotency_key: str | None = None,
    session: Session = Depends(get_session)
):
    return create_appointment_capability(
        session=session,
        hospital_id=hospital_id,
        doctor_id=doctor_id,
        patient_id=patient_id,
        start_time=start_time,
        end_time=end_time,
        appointment_type=appointment_type,
        idempotency_key=idempotency_key,
    )
@router.post("/test-unknown-outcome")
def test_unknown_outcome(
    session: Session = Depends(get_session),
):
    from datetime import timedelta

    doctor_id = 1
    hospital_id = 1
    patient_id = 3

    # Find availability records
    availability_records = session.exec(
        select(Availability).where(
            Availability.doctor_id == doctor_id,
            Availability.is_available == True,
        )
    ).all()

    selected_start = None
    selected_end = None

    # Find a genuinely free 30-minute slot
    for availability in availability_records:

        candidate_start = availability.start_time
        availability_end = availability.end_time

        while candidate_start + timedelta(minutes=30) <= availability_end:

            candidate_end = (
                candidate_start + timedelta(minutes=30)
            )

            overlapping = session.exec(
                select(Appointment).where(
                    Appointment.doctor_id == doctor_id,
                    Appointment.start_time < candidate_end,
                    Appointment.end_time > candidate_start,
                    Appointment.status.in_(
                        [
                            "PENDING",
                            "CONFIRMED",
                            "RESCHEDULED",
                        ]
                    ),
                )
            ).first()

            if not overlapping:
                selected_start = candidate_start
                selected_end = candidate_end
                break

            candidate_start = candidate_end

        if selected_start:
            break

    if not selected_start:
        return {
            "success": False,
            "message": (
                "No genuinely available 30-minute slot "
                "was found for doctor 1."
            ),
        }

    # Run Unknown Outcome Recovery
    result = create_appointment_capability(
        session=session,
        hospital_id=hospital_id,
        doctor_id=doctor_id,
        patient_id=patient_id,
        start_time=selected_start,
        end_time=selected_end,
        appointment_type="IN_PERSON",
        idempotency_key=(
            f"unknown-outcome-test-"
            f"{patient_id}-"
            f"{doctor_id}-"
            f"{selected_start.isoformat()}"
        ),
        simulate_unknown_outcome=True,
    )

    return {
        "test": "UNKNOWN_OUTCOME_RECOVERY",
        "selected_slot": {
            "start_time": selected_start,
            "end_time": selected_end,
        },
        "result": result,
    }
